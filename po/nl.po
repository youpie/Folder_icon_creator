msgstr ""
"Schakel automatische regeneratie van folders wanneer je systeem accentkleur "
"veranderd in"

#: src/settings/settings.blp:206
msgid "Automatic Genereration"
msgstr "Automatische Regeneratie"

#: src/settings/settings.blp:207
msgid "Automatically regenerate the Icons when the system accent color changes"
